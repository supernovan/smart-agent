<idea-plugin>
    <id>se.kodasmart.smartagent</id>
    <name>SmartAgent</name>
    <vendor>Code Smart AB</vendor>
    <description><![CDATA[
        <p><b>SmartAgent</b> is an autonomous AI coding assistant..</p>
        <p>Features intelligent project repo-mapping, local workspace file tools, autonomous planning, and custom architectural rule enforcement.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <resource-bundle>messages.MyBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow factoryClass="se.kodasmart.smartagent.toolWindow.AgentToolWindowFactory"
                    id="GeminiAgent"
                    displayName="Gemini Agent"
                    anchor="right"
                    icon="/icons/gemini_icon.svg"/>

        <postStartupActivity implementation="se.kodasmart.smartagent.startup.MyProjectActivity" />
    </extensions>
</idea-plugin>